{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@usagepay/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@usagepay/fixtures": [
        "./fixtures/src/index.ts"
      ],
      "@usagepay/metering": [
        "./packages/metering/src/index.ts"
      ],
      "@usagepay/settlement": [
        "./packages/settlement/src/index.ts"
      ],
      "@usagepay/verification": [
        "./packages/verification/src/index.ts"
      ],
      "@usagepay/demo": [
        "./apps/demo/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "fixtures/src/**/*.ts",
    "fixtures/test/**/*.ts",
    "vitest.config.ts",
    "vitest.aliases.ts"
  ],
  "exclude": [
    "apps/web/**"
  ]
}
