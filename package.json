{
  "name": "usagepay",
  "version": "0.0.0",
  "private": true,
  "description": "UsagePay HackMeridian P0 monorepo (Stellar Testnet only).",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.tests.json",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:contracts": "vitest run --project contracts --project fixtures --project integration",
    "fixtures:generate": "tsc -b && node fixtures/dist/cli.js generate",
    "fixtures:check": "tsc -b && node fixtures/dist/cli.js check",
    "versions:check": "node scripts/check-versions.mjs",
    "g1:lifecycle": "tsc -b && node scripts/testnet/g1/run.ts",
    "typecheck:testnet": "tsc -b && tsc -p scripts/testnet/tsconfig.json",
    "g2:settlement": "tsc -b && node scripts/testnet/g2/run.ts",
    "verify": "tsc -b && node packages/verification/dist/bin.js",
    "g3:verify": "tsc -b && node scripts/testnet/g3/run.ts",
    "test:e2e:testnet": "tsc -b && node scripts/testnet/e2e/run.ts",
    "demo": "tsc -b && node apps/demo/dist/bin.js",
    "typecheck:web": "tsc -b && tsc -p apps/web/tsconfig.test.json",
    "ui:dev": "tsc -b && vite apps/web",
    "ui:build": "tsc -b && (node apps/demo/dist/bin.js; test $? -le 2) && tsc -p apps/web/tsconfig.json && vite build apps/web",
    "ui:preview": "vite preview apps/web"
  },
  "dependencies": {
    "@stellar/mpp": "0.7.1",
    "@stellar/stellar-sdk": "15.1.0",
    "@usagepay/contracts": "workspace:*",
    "@usagepay/demo": "workspace:*",
    "@usagepay/fixtures": "workspace:*",
    "@usagepay/metering": "workspace:*",
    "@usagepay/settlement": "workspace:*",
    "@usagepay/verification": "workspace:*",
    "mppx": "0.6.31",
    "viem": "2.57.10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
